    {
      "name": "create_order",
      "description": "Создаёт заказ, когда участник хочет купить товар: за одну транзакцию записывает заказ, списывает коины и резервирует остаток. quantity по умолчанию 1; от 3 единиц действует скидка 10% (итог округляется вниз). Проверки по порядку: USER_NOT_FOUND, PRODUCT_NOT_FOUND, OUT_OF_STOCK (нет размера или мало остатка), USER_LIMIT_EXCEEDED, INSUFFICIENT_COINS. При любом отказе данные не меняются.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1
          },
          "product_id": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        },
        "required": [
          "user_id",
          "product_id",
          "size"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "const": "created"
                  },
                  "total_price": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "order_id",
                  "status",
                  "total_price"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ok",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": false
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "PRODUCT_NOT_FOUND",
                      "USER_NOT_FOUND",
                      "OUT_OF_STOCK",
                      "USER_LIMIT_EXCEEDED",
                      "INSUFFICIENT_COINS",
                      "ORDER_NOT_FOUND",
                      "ORDER_STATUS_ERROR"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ok",
              "error"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "cancel_order",
      "description": "Отменяет ещё не выданный заказ (статус created): возвращает на склад товар, а участнику — ровно ту сумму, что была списана при создании, один раз. Выданный (picked_up) или уже отменённый заказ отменить нельзя — ORDER_STATUS_ERROR; неизвестный заказ — ORDER_NOT_FOUND.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "order_id"
        ],
        "additionalProperties": false
