                      "USER_NOT_FOUND",
                      "OUT_OF_STOCK",
                      "USER_LIMIT_EXCEEDED",
                      "INSUFFICIENT_COINS",
                      "ORDER_NOT_FOUND",
                      "ORDER_STATUS_ERROR"
                    ]
