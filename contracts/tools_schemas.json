              "ok": {
                "const": true
              },
              "data": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "const": "cancelled"
                  }
