            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "confirm_pickup",
      "description": "Отмечает, что участник забрал заказ: меняет только статус created → picked_up, коины и остатки не трогает (они уже списаны при создании). Отменённый или уже выданный заказ — ORDER_STATUS_ERROR; неизвестный заказ — ORDER_NOT_FOUND.",
      "inputSchema": {
